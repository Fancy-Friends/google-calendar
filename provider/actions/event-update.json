{
  "$comment": "events.patch -> PATCH calendar/v3/calendars/{calendarId}/events/{eventId}, request+response Event. Read from the discovery document 2026-09-30. PATCH rather than events.update (PUT): PUT requires resending the WHOLE event representation or Google treats every omitted field as cleared, which is a trap for a host that only wants to change one field. PATCH only touches what is present in the body. Scope unchanged: calendar.events already covers write. Same deliberate omissions as event_create -- no attendees, no recurrence, no all-day (date-only) support -- for the same reason: no array-of-objects config shape exists anywhere in this estate yet.",
  "operation": "event_update",
  "kind": "event_update",
  "title": "Update Google Calendar event",
  "description": "Change one or more fields of an existing event. Only the fields provided are touched.",
  "summary": "update an event",
  "docs": "https://developers.google.com/workspace/calendar/api/v3/reference/events/patch",
  "sideEffects": "idempotent",
  "$sideEffectsComment": "Re-sending the same PATCH body twice leaves the event in the same state both times -- nothing compounds, unlike event_create's insert.",

  "request": {
    "method": "PATCH",
    "path": "/calendar/v3/calendars/{calendarId}/events/{eventId}",
    "encoding": "json"
  },

  "config": [
    {
      "type": "text",
      "key": "calendarId",
      "label": "Calendar ID",
      "required": true,
      "default": "primary",
      "send": { "in": "path", "as": "calendarId", "value": "string" }
    },
    {
      "type": "text",
      "key": "eventId",
      "label": "Event ID",
      "required": true,
      "description": "From event_create's data.id, or event_list/event_get.",
      "send": { "in": "path", "as": "eventId", "value": "string" }
    },
    {
      "type": "text",
      "key": "summary",
      "label": "Title",
      "send": { "as": "summary", "value": "string", "omitEmpty": true }
    },
    {
      "type": "textarea",
      "key": "description",
      "label": "Description",
      "send": { "as": "description", "value": "string", "omitEmpty": true }
    },
    {
      "type": "text",
      "key": "location",
      "label": "Location",
      "send": { "as": "location", "value": "string", "omitEmpty": true }
    },
    {
      "type": "text",
      "key": "startDateTime",
      "label": "Start",
      "description": "RFC 3339. Leave blank to leave the start time unchanged.",
      "send": { "as": "start.dateTime", "value": "string", "omitEmpty": true }
    },
    {
      "type": "text",
      "key": "startTimeZone",
      "label": "Start time zone",
      "send": { "as": "start.timeZone", "value": "string", "omitEmpty": true }
    },
    {
      "type": "text",
      "key": "endDateTime",
      "label": "End",
      "description": "RFC 3339. Leave blank to leave the end time unchanged.",
      "send": { "as": "end.dateTime", "value": "string", "omitEmpty": true }
    },
    {
      "type": "text",
      "key": "endTimeZone",
      "label": "End time zone",
      "send": { "as": "end.timeZone", "value": "string", "omitEmpty": true }
    },
    {
      "type": "select",
      "key": "status",
      "label": "Status",
      "options": [
        { "value": "confirmed", "label": "Confirmed" },
        { "value": "tentative", "label": "Tentative" },
        { "value": "cancelled", "label": "Cancelled" }
      ],
      "description": "Setting cancelled here has the same effect as event_delete -- offered because PATCH is also Google's documented way to cancel one instance of a recurring event, which event_delete (which removes the whole resource) cannot target.",
      "send": { "as": "status", "value": "string", "omitEmpty": true }
    },
    {
      "type": "select",
      "key": "visibility",
      "label": "Visibility",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "public", "label": "Public" },
        { "value": "private", "label": "Private" }
      ],
      "send": { "as": "visibility", "value": "string", "omitEmpty": true }
    },
    {
      "type": "select",
      "key": "transparency",
      "label": "Show me as",
      "options": [
        { "value": "opaque", "label": "Busy" },
        { "value": "transparent", "label": "Available" }
      ],
      "send": { "as": "transparency", "value": "string", "omitEmpty": true }
    },
    {
      "type": "text",
      "key": "colorId",
      "label": "Color ID",
      "send": { "as": "colorId", "value": "string", "omitEmpty": true }
    }
  ],

  "outputShape": [
    { "path": "data.id", "type": "string", "description": "The event's id." },
    { "path": "data.status", "type": "string", "description": "The event's status after this update." },
    { "path": "data.summary", "type": "string", "description": "The event's title after this update." },
    { "path": "data.htmlLink", "type": "string", "description": "The event in the Google Calendar UI." },
    { "path": "data.start.dateTime", "type": "string", "description": "The event's start after this update." },
    { "path": "data.end.dateTime", "type": "string", "description": "The event's end after this update." },
    { "path": "data.updated", "type": "string", "description": "RFC 3339 last modification -- now." },
    { "path": "mode", "type": "string", "description": "Which estate this ran against. Google has no sandbox, so: fake or live." }
  ],

  "contract": {
    "sends": ["calendarId", "eventId", "summary", "description", "location", "start", "end", "status", "visibility", "transparency", "colorId"],
    "reads": ["id", "status", "summary", "htmlLink", "start", "end", "updated"]
  }
}
